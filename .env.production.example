# Copy this file to .env on the server and replace every CHANGE_ME value.
DOCKER_USERNAME=CHANGE_ME
TAG=pdn-latest

ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=CHANGE_ME
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME
EDUCATION_DB_NAME=education_db
EDUCATION_DB_USER=education_user
EDUCATION_DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_BYTES
JWT_EXPIRATION=3600000
AUTH_LOGIN_PATH=/api/v1/auth/login

CORS_ALLOWED_ORIGINS=https://lms.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=60
RATE_LIMIT_KEY_PREFIX=rate_limit:

FRONTEND_URL=https://lms.example.com
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_STARTTLS=true
MAIL_FROM=no-reply@example.com

FILES_STORAGE=local
FILES_MAX_SIZE_BYTES=10485760
# For S3, set FILES_STORAGE=s3 and configure the following values.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PATH_STYLE=false
S3_PREFIX=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

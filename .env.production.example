# Copy this file to .env on the server and replace every CHANGE_ME value.
# Registro de las imágenes (las publican los workflows de los dos repos).
IMAGE_REGISTRY=ghcr.io/gems-innovations
TAG=pdn-latest

ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=CHANGE_ME
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME
EDUCATION_DB_NAME=education_db
EDUCATION_DB_USER=education_user
EDUCATION_DB_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_BYTES
JWT_EXPIRATION=3600000
# Clave de las rutas internas entre servicios (/internal/**). Vacía: se usa JWT_SECRET. Recomendado: una propia de 64+ caracteres.
INTERNAL_API_KEY=

CORS_ALLOWED_ORIGINS=https://lms.gemsinnovations.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Por usuario autenticado; las peticiones sin sesión (login, recuperar contraseña) se cuentan por IP.
RATE_LIMIT_REQUESTS=300
# Un campus suele salir por una sola IP: este límite lo comparten todos sus inicios de sesión.
RATE_LIMIT_ANONYMOUS_REQUESTS=600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_KEY_PREFIX=rate_limit:

FRONTEND_URL=https://lms.gemsinnovations.com
# URL pública del api-gateway que usa el navegador (se escribe en config.js del front).
API_BASE_URL=https://api.auth.gemsinnovations.com/api/v1
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_STARTTLS=true
MAIL_FROM=no-reply@example.com

FILES_STORAGE=local
FILES_MAX_SIZE_BYTES=10485760
# For S3, set FILES_STORAGE=s3 and configure the following values.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PATH_STYLE=false
S3_PREFIX=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Puertos de loopback por los que el nginx del sistema llega al gateway y al front.
GATEWAY_HOST_PORT=18080
WEB_HOST_PORT=18081
# Memoria por microservicio Java (4 servicios).
JAVA_MEM_LIMIT=1g
